# Base URL of the Spinner API. Development may use a LAN address.
# Preview and production must use HTTPS.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:5235

# Google Maps key for the Android pickup map.
# Set this in every EAS environment (development, preview, production).
# Without it the native map renders blank and the pickup screen reports
# "Map service not configured".
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_ANDROID_MAPS_KEY
