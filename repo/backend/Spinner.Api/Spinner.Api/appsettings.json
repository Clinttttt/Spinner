{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Business": {
    "TimeZone": "Asia/Manila"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "SeedData": {
    "EnableDevelopmentDefaults": false
  },
  "NotificationOutbox": {
    "Enabled": true,
    "BatchSize": 20,
    "MaxAttempts": 3,
    "PollIntervalSeconds": 30
  },
  "NotificationDelivery": {
    "EmailProvider": "Resend",
    "SmsProvider": "Logging"
  },
  "Resend": {
    "BaseUrl": "https://api.resend.com/",
    "ApiKey": "",
    "FromEmail": "",
    "FromName": "",
    "DefaultSubject": "Laundry Update"
  },
  "AccountSecurity": {
    "VerificationCodeMinutes": 15,
    "PasswordResetCodeMinutes": 15,
    "ResendCooldownSeconds": 60,
    "MaxCodeAttempts": 5
  },
  "OnlinePayments": {
    "PublicPaymentBaseUrl": "/pay",
    "WebhookSecret": "",
    "PayMongoSecretKey": "",
    "PayMongoWebhookSecret": "",
    "CheckoutSuccessUrl": "",
    "CheckoutCancelUrl": "",
    "CheckoutMinutesToLive": 60
  },
  "MediaStorage": {
    "AccountId": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "BucketName": "",
    "PublicBaseUrl": "",
    "MaxUploadBytes": 5242880,
    "CacheMaxAgeSeconds": 31536000
  }
}
