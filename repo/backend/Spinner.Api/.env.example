ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__DefaultConnection=Host=spinner-db.example.postgres.database.azure.com;Port=5432;Database=spinner;Username=spinner_admin;Password=replace-me;SSL Mode=Require
Jwt__Key=replace-with-a-random-secret-at-least-32-characters-long
Jwt__Issuer=Spinner.Api
Jwt__Audience=Spinner.Client
OnlinePayments__WebhookSecret=replace-with-a-random-secret-at-least-32-characters-long
OnlinePayments__PublicPaymentBaseUrl=https://booking.example.com/pay
Cors__AllowedOrigins__0=https://booking.example.com
SeedData__EnableDevelopmentDefaults=false
NotificationDelivery__EmailProvider=Resend
NotificationDelivery__SmsProvider=Logging
Resend__ApiKey=re_replace-with-a-resend-api-key
Resend__FromEmail=notifications@updates.example.com
Resend__FromName=Engr. Spin Laundromat

# Business calendar time zone. Decides what "today" means for the operations
# dashboard and the pickup schedule. Defaults to Asia/Manila.
Business__TimeZone=Asia/Manila

# Set to true only for a one-off migration container. The process applies
# pending EF Core migrations and exits instead of serving HTTP. Equivalent to
# passing --migrate on the command line. Only the connection string above is
# required when this is enabled.
# SPINNER_RUN_MIGRATIONS=true
